                banner.className = 'bg-blue-600 text-white px-4 py-2.5 shadow-md transition-colors duration-300 flex items-center justify-between gap-3 z-30';
                badge.innerHTML = `<i data-lucide="megaphone" class="w-4 h-4"></i> 試務公告`;
