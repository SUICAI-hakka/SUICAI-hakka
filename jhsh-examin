        // 渲染節次下拉選單
        function renderSessionSelector() {
            const selector = document.getElementById('sessionSelector');
            selector.innerHTML = appState.sessions.map(s => `
                <option value="${s.id}" ${s.id === appState.currentSessionId ? 'selected' : ''}>
                    ${s.name} (${s.start}-${s.end})
                </option>
            `).join('');
        }

        // 渲染全校總體 KPI 統計
        function renderKPIs() {
            let totalExpected = 0;
            let totalAbsent = 0;
            let completedRooms = 0;

            appState.rooms.forEach(room => {
                totalExpected += Number(room.expected) || 0;
                totalAbsent += (room.absents ? room.absents.length : 0);
                if (room.paperStatus === 'COMPLETED') completedRooms++;
            });

            const totalActual = Math.max(0, totalExpected - totalAbsent);
            const unresolvedIncidents = appState.logs.filter(l => l.type === 'INCIDENT' && !l.resolved).length;
            const totalRooms = appState.rooms.length;
            const collectionRate = totalRooms > 0 ? Math.round((completedRooms / totalRooms) * 100) : 0;

            document.getElementById('statExpected').textContent = totalExpected;
            document.getElementById('statActual').textContent = totalActual;
            document.getElementById('statAbsent').textContent = totalAbsent;
            document.getElementById('statIncidents').textContent = unresolvedIncidents;
            document.getElementById('statCollectionRate').textContent = `${collectionRate}%`;
            document.getElementById('statCollectionText').textContent = `${completedRooms}/${totalRooms} 班`;
            document.getElementById('statCollectionBar').style.width = `${collectionRate}%`;
        }

        // 渲染考場卡片網格
        function renderClassrooms() {
            const grid = document.getElementById('classroomGrid');
            const keyword = document.getElementById('searchInput').value.trim().toLowerCase();

            const filteredRooms = appState.rooms.filter(room => {
                // 年級篩選
                if (currentGradeFilter !== 'ALL' && room.grade !== currentGradeFilter) return false;
                
                // 狀態篩選
                const absentCount = room.absents ? room.absents.length : 0;
                if (currentStatusFilter === 'INCIDENT' && !room.hasIncident) return false;
                if (currentStatusFilter === 'ABSENT' && absentCount === 0) return false;
                if (currentStatusFilter === 'UNCOLLECTED' && room.paperStatus !== 'UNCOLLECTED') return false;
                if (currentStatusFilter === 'TESTING' && room.paperStatus !== 'TESTING') return false;
                if (currentStatusFilter === 'COMPLETED' && room.paperStatus !== 'COMPLETED') return false;

                // 關鍵字搜尋
                if (keyword) {
                    const matchCode = room.code.toLowerCase().includes(keyword);
                    const matchProctor = room.proctor.toLowerCase().includes(keyword);
                    if (!matchCode && !matchProctor) return false;
                }
                return true;
            });

            if (filteredRooms.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full bg-slate-900/50 border border-dashed border-slate-800 rounded-2xl p-12 text-center">
                        <i data-lucide="inbox" class="w-10 h-10 text-slate-600 mx-auto mb-2"></i>
                        <p class="text-slate-400 font-medium">沒有符合篩選條件的考場教室</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            grid.innerHTML = filteredRooms.map(room => {
                const absentCount = room.absents ? room.absents.length : 0;
                const actualCount = Math.max(0, room.expected - absentCount);

                // 決定卡片視覺狀態樣式
                let cardBorder = 'border-slate-800 hover:border-slate-600';
                let cardBg = 'bg-slate-900';
                let statusBadge = '';

                if (room.hasIncident) {
                    cardBorder = 'border-rose-500/80 ring-1 ring-rose-500/40';
                    cardBg = 'bg-rose-950/20';
                    statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40 flex items-center gap-1 animate-pulse"><i data-lucide="alert-triangle" class="w-3 h-3"></i> 異常通報</span>`;
                } else if (room.paperStatus === 'COMPLETED') {
                    cardBorder = 'border-indigo-500/50 hover:border-indigo-400';
                    cardBg = 'bg-indigo-950/15';
                    statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 flex items-center gap-1"><i data-lucide="check-circle-2" class="w-3 h-3"></i> 已交卷</span>`;
                } else if (absentCount > 0) {
                    cardBorder = 'border-amber-500/50 hover:border-amber-400';
                    statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center gap-1"><i data-lucide="user-x" class="w-3 h-3"></i> 缺考 ${absentCount} 人</span>`;
                } else if (room.paperStatus === 'UNCOLLECTED') {
                    cardBorder = 'border-slate-700 border-dashed';
                    statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-800 text-slate-400 border border-slate-700">未領卷</span>`;
                } else {
                    statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> 考試中</span>`;
                }

                // 缺考座號標籤
                const absentBadgesHtml = absentCount > 0 
                    ? `<div class="mt-2.5 pt-2 border-t border-slate-800/80 flex flex-wrap items-center gap-1.5">
                        <span class="text-[11px] text-amber-400/90 font-semibold">缺考座號：</span>
                        ${room.absents.map(a => `<span class="text-[11px] font-mono font-bold bg-amber-950/80 text-amber-300 border border-amber-800/60 px-1.5 py-0.5 rounded" title="${a.name} (${a.reason})">${a.seat}號(${a.reason})</span>`).join('')}
                       </div>`
                    : `<div class="mt-2.5 pt-2 border-t border-slate-800/60 text-[11px] text-slate-500 flex items-center justify-between">
                        <span>全員到齊無缺考</span>
                        <span class="text-slate-600">點擊編輯詳情</span>
                       </div>`;

                // 試卷狀態快速切換按鈕樣式
                let nextPaperLabel = '';
                let nextPaperStyle = '';
                if (room.paperStatus === 'UNCOLLECTED') {
                    nextPaperLabel = '領卷開始考試';
                    nextPaperStyle = 'bg-slate-800 hover:bg-emerald-600 text-slate-200 hover:text-white border-slate-700';
                } else if (room.paperStatus === 'TESTING') {
                    nextPaperLabel = '標記已交卷';
                    nextPaperStyle = 'bg-emerald-950/60 hover:bg-indigo-600 text-emerald-300 hover:text-white border-emerald-800/60';
                } else {
                    nextPaperLabel = '已交卷 (點擊重設)';
                    nextPaperStyle = 'bg-indigo-600/30 hover:bg-slate-800 text-indigo-200 border-indigo-500/40';
                }

                return `
                    <div onclick="openRoomDetailModal('${room.id}')" class="${cardBg} border ${cardBorder} rounded-2xl p-4 cursor-pointer transition-all duration-200 hover:-translate-y-0.5 shadow-lg flex flex-col justify-between group">
                        <div>
                            <!-- 卡片頂部：班級編號與狀態 -->
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-2xl font-black text-white tracking-tight group-hover:text-indigo-300 transition">${room.code}</span>
                                        <span class="text-xs text-slate-400 bg-slate-950 px-2 py-0.5 rounded-md border border-slate-800">監考：${room.proctor}</span>
                                    </div>
                                </div>
                                ${statusBadge}
                            </div>

                            <!-- 人數統計三欄 -->
                            <div class="grid grid-cols-3 gap-2 mt-3.5 bg-slate-950/70 p-2.5 rounded-xl border border-slate-800/80 text-center">
                                <div>
                                    <div class="text-[10px] text-slate-400">應到</div>
                                    <div class="text-base font-mono font-bold text-slate-200 tabular-nums">${room.expected}</div>
                                </div>
                                <div class="border-x border-slate-800">
                                    <div class="text-[10px] text-emerald-400">實到</div>
                                    <div class="text-base font-mono font-black text-emerald-400 tabular-nums">${actualCount}</div>
                                </div>
                                <div>
                                    <div class="text-[10px] text-amber-400">缺考</div>
                                    <div class="text-base font-mono font-black ${absentCount > 0 ? 'text-amber-400' : 'text-slate-500'} tabular-nums">${absentCount}</div>
                                </div>
                            </div>

                            <!-- 缺考明細 -->
                            ${absentBadgesHtml}
                        </div>

                        <!-- 卡片底部快速操作列 (阻止事件冒泡避免觸發 Modal) -->
                        <div class="mt-3 pt-2.5 border-t border-slate-800/80 flex items-center justify-between gap-2" onclick="event.stopPropagation()">
                            <button onclick="cyclePaperStatus('${room.id}')" class="flex-1 text-xs font-bold py-1.5 px-2.5 rounded-lg border transition flex items-center justify-center gap-1.5 ${nextPaperStyle}">
                                <i data-lucide="file-check-2" class="w-3.5 h-3.5"></i>
                                <span>${nextPaperLabel}</span>
                            </button>
                            <button onclick="openRoomDetailModal('${room.id}')" title="缺考與異常回報" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">
                                <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            lucide.createIcons();
        }

        // 渲染右側即時異常與缺考時間軸
        function renderTimeline() {
            const container = document.getElementById('incidentTimeline');
            const filteredLogs = appState.logs.filter(log => {
                if (currentLogFilter === 'UNRESOLVED' && log.resolved) return false;
                return true;
            });

            document.getElementById('logCountBadge').textContent = `${filteredLogs.length} 筆`;

            if (filteredLogs.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10 text-slate-500 text-xs">
                        <i data-lucide="check-circle" class="w-8 h-8 mx-auto mb-2 text-slate-700"></i>
                        目前沒有符合條件的動態紀錄
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            container.innerHTML = filteredLogs.map(log => {
                const isIncident = log.type === 'INCIDENT';
                const isMemo = log.type === 'MEMO';
                
                let badgeColor = 'bg-amber-500/20 text-amber-300 border-amber-500/30';
                let iconName = 'user-x';
                if (isIncident) {
                    badgeColor = log.resolved 
                        ? 'bg-slate-800 text-slate-400 border-slate-700' 
                        : 'bg-rose-500/20 text-rose-300 border-rose-500/40';
                    iconName = 'alert-triangle';
                } else if (isMemo) {
                    badgeColor = 'bg-indigo-500/20 text-indigo-300 border-indigo-500/30';
                    iconName = 'pin';
                }

                return `
                    <div class="bg-slate-950/90 border ${!log.resolved && isIncident ? 'border-rose-500/50' : 'border-slate-800'} rounded-xl p-3 transition">
                        <div class="flex items-center justify-between gap-2 mb-1.5">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-mono font-bold text-slate-400">${log.time}</span>
                                <span class="text-xs font-black bg-slate-800 text-white px-2 py-0.5 rounded">${log.room}</span>
                                <span class="text-[11px] font-bold px-2 py-0.5 rounded border ${badgeColor} flex items-center gap-1">
                                    <i data-lucide="${iconName}" class="w-3 h-3"></i> ${log.title}
                                </span>
                            </div>
                        </div>
                        <p class="text-xs text-slate-300 leading-relaxed mb-2.5">${log.detail}</p>
                        <div class="flex items-center justify-between pt-2 border-t border-slate-800/80">
