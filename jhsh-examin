<!DOCTYPE html>
<html lang="zh-Hant" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>段考考務即時管理系統 (Exam Control Center)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts: Inter & Noto Sans TC -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans TC"', 'Inter', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    animation: {
                        'pulse-fast': 'pulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'marquee': 'marquee 25s linear infinite',
                    },
                    keyframes: {
                        marquee: {
                            '0%': { transform: 'translateX(100%)' },
                            '100%': { transform: 'translateX(-100%)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* 自定義捲軸樣式，適合大螢幕深色背景 */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a; 
        }
        ::-webkit-scrollbar-thumb {
            background: #334155; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569; 
        }
        /* 數位時鐘等寬數字防抖動 */
        .tabular-nums {
            font-variant-numeric: tabular-nums;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white min-h-screen flex flex-col">

    <!-- 試務廣播與公告橫幅 (Exam Broadcast & Alerts) -->
    <div id="broadcastBanner" class="bg-blue-600 text-white px-4 py-2.5 shadow-md transition-colors duration-300 flex items-center justify-between gap-3 z-30">
        <div class="flex items-center gap-2.5 shrink-0 font-bold tracking-wide">
            <span id="broadcastBadge" class="bg-white/20 px-2 py-0.5 rounded text-xs uppercase flex items-center gap-1">
                <i data-lucide="megaphone" class="w-4 h-4"></i> 試務公告
            </span>
        </div>
        <div class="flex-1 overflow-hidden relative h-6 flex items-center">
            <p id="broadcastText" class="font-medium text-sm md:text-base whitespace-nowrap truncate">
                請各監考老師於預備鈴響時準時發卷，提醒學生檢查試卷頁數與印刷是否清晰。
            </p>
        </div>
        <button onclick="openBroadcastModal()" class="shrink-0 bg-black/25 hover:bg-black/40 text-white text-xs md:text-sm px-3 py-1 rounded-lg font-medium transition flex items-center gap-1.5 border border-white/15">
            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
            <span>發布/修改廣播</span>
        </button>
    </div>

    <!-- 頂部狀態列 (Header) -->
    <header class="bg-slate-900 border-b border-slate-800 px-4 lg:px-6 py-4 shadow-xl z-20">
        <div class="max-w-[1800px] mx-auto flex flex-col xl:flex-row items-stretch xl:items-center justify-between gap-4">
            
            <!-- 左側：系統標題與即時數位時鐘 -->
            <div class="flex flex-wrap items-center justify-between xl:justify-start gap-4 lg:gap-6">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-500/30 border border-indigo-400/30">
                        <i data-lucide="shield-check" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <h1 class="text-lg md:text-xl font-black tracking-tight text-white leading-tight">
                            段考考務即時管理系統
                        </h1>
                        <p class="text-xs text-slate-400 font-mono tracking-wider">EXAM CONTROL CENTER</p>
                    </div>
                </div>

                <!-- 數位時鐘 -->
                <div class="bg-slate-950/90 border border-slate-800 rounded-xl px-4 py-2 flex items-center gap-3 shadow-inner">
                    <i data-lucide="clock" class="w-5 h-5 text-indigo-400"></i>
                    <div>
                        <div id="liveClock" class="text-xl md:text-2xl font-mono font-bold text-white tabular-nums leading-none">00:00:00</div>
                        <div id="liveDate" class="text-[11px] text-slate-400 mt-1 font-medium">2026/11/11 (週三)</div>
                    </div>
                </div>
            </div>

            <!-- 中間：當前節次選擇與考場倒數計時器 -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 bg-slate-800/60 p-2.5 rounded-2xl border border-slate-700/80">
                <!-- 節次切換 -->
                <div class="flex items-center gap-2">
                    <div class="relative flex-1 sm:flex-initial">
                        <select id="sessionSelector" onchange="changeSession(this.value)" class="w-full sm:w-64 appearance-none bg-slate-900 border border-slate-700 hover:border-indigo-500 text-white font-bold text-sm md:text-base rounded-xl pl-3.5 pr-9 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition cursor-pointer">
                            <!-- 動態生成節次選項 -->
                        </select>
                        <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    </div>
                    <button onclick="openSessionModal()" title="編輯節次與時間" class="p-2.5 bg-slate-900 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl border border-slate-700 transition">
                        <i data-lucide="settings" class="w-5 h-5"></i>
                    </button>
                </div>

                <!-- 倒數計時與狀態指示器 -->
                <div class="flex items-center justify-between sm:justify-start gap-4 bg-slate-950 px-4 py-2 rounded-xl border border-slate-800 min-w-[260px]">
                    <div class="flex flex-col">
                        <div class="flex items-center gap-2">
                            <span id="timerStatusDot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                            <span id="timerStatusText" class="text-xs font-bold text-emerald-400 tracking-wide">考試進行中</span>
                        </div>
                        <div class="w-32 bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
                            <div id="timerProgressBar" class="bg-emerald-500 h-full transition-all duration-500" style="width: 65%"></div>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-[10px] text-slate-400 uppercase font-semibold">剩餘時間</div>
                        <div id="countdownDisplay" class="text-xl md:text-2xl font-mono font-extrabold text-amber-400 tabular-nums leading-none mt-0.5">45:00</div>
                    </div>
                    <!-- 模擬時間測試小按鈕 (方便試務人員預覽不同時段效果) -->
                    <button onclick="toggleSimulationMode()" id="simBtn" title="切換「即時系統時間」或「模擬考試中倒數」" class="text-[11px] px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">
                        模擬中
                    </button>
                </div>
            </div>

            <!-- 右側：資料管理操作按鈕 -->
            <div class="flex items-center justify-end gap-2">
                <button onclick="exportCSV()" class="flex-1 sm:flex-initial bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-4 py-2.5 rounded-xl shadow-lg shadow-emerald-900/30 transition flex items-center justify-center gap-2">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>匯出報表 (CSV)</span>
                </button>
                <button onclick="openResetConfirmModal()" class="bg-slate-800 hover:bg-rose-950/80 text-slate-300 hover:text-rose-300 border border-slate-700 hover:border-rose-800 font-medium text-sm px-3.5 py-2.5 rounded-xl transition flex items-center justify-center gap-1.5" title="重置所有考場為預設模擬資料">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">重置資料</span>
                </button>
            </div>
        </div>

        <!-- 全校總體統計看板 (KPI Bar) -->
        <div class="max-w-[1800px] mx-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mt-4 pt-4 border-t border-slate-800/80">
            <!-- 應到總人數 -->
            <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3 flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-400 font-medium">應到總人數</p>
                    <p id="statExpected" class="text-2xl font-black text-white tabular-nums mt-0.5">0</p>
                </div>
                <div class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center text-slate-300">
                    <i data-lucide="users" class="w-5 h-5"></i>
                </div>
            </div>

            <!-- 實到總人數 -->
            <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3 flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-400 font-medium">實到總人數</p>
                    <p id="statActual" class="text-2xl font-black text-emerald-400 tabular-nums mt-0.5">0</p>
                </div>
                <div class="w-10 h-10 rounded-lg bg-emerald-950/60 border border-emerald-800/40 flex items-center justify-center text-emerald-400">
                    <i data-lucide="user-check" class="w-5 h-5"></i>
                </div>
            </div>

            <!-- 缺考總人數 -->
            <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3 flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-400 font-medium">缺考總人數</p>
                    <p id="statAbsent" class="text-2xl font-black text-amber-400 tabular-nums mt-0.5">0</p>
                </div>
                <div class="w-10 h-10 rounded-lg bg-amber-950/60 border border-amber-800/40 flex items-center justify-center text-amber-400">
                    <i data-lucide="user-x" class="w-5 h-5"></i>
                </div>
            </div>

            <!-- 異常通報件數 -->
            <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3 flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-400 font-medium">待處理異常通報</p>
                    <p id="statIncidents" class="text-2xl font-black text-rose-400 tabular-nums mt-0.5">0</p>
                </div>
                <div class="w-10 h-10 rounded-lg bg-rose-950/60 border border-rose-800/40 flex items-center justify-center text-rose-400">
                    <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                </div>
            </div>

            <!-- 試卷回收完成率 -->
            <div class="col-span-2 sm:col-span-1 bg-slate-950/70 border border-slate-800 rounded-xl p-3 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <p class="text-xs text-slate-400 font-medium">試卷回收完成率</p>
                    <span id="statCollectionText" class="text-xs font-mono text-indigo-300 font-bold">0/0 班</span>
                </div>
                <div class="flex items-end justify-between gap-3 mt-1">
                    <p id="statCollectionRate" class="text-2xl font-black text-indigo-400 tabular-nums leading-none">0%</p>
                    <div class="flex-1 bg-slate-800 h-2.5 rounded-full overflow-hidden mb-1">
                        <div id="statCollectionBar" class="bg-indigo-500 h-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- 主內容區：左側考場網格 + 右側即時通報紀錄 -->
    <main class="flex-1 max-w-[1800px] w-full mx-auto p-4 lg:p-6 grid grid-cols-1 xl:grid-cols-12 gap-6">
        
        <!-- 左側：考場教室即時監控網格 (佔 8 或 9 欄) -->
        <section class="xl:col-span-8 2xl:col-span-9 flex flex-col gap-4">
            <!-- 篩選與操作工具列 -->
            <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-3.5 flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-2">
                    <!-- 年級篩選 -->
                    <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-800">
                        <button onclick="setGradeFilter('ALL')" data-grade="ALL" class="grade-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 text-white transition">全部年級</button>
                        <button onclick="setGradeFilter('7')" data-grade="7" class="grade-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition">七年級</button>
                        <button onclick="setGradeFilter('8')" data-grade="8" class="grade-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition">八年級</button>
                        <button onclick="setGradeFilter('9')" data-grade="9" class="grade-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition">九年級</button>
                    </div>

                    <!-- 狀態篩選 -->
                    <select id="statusFilter" onchange="setStatusFilter(this.value)" class="bg-slate-950 border border-slate-800 text-slate-200 text-xs font-bold rounded-xl px-3 py-2 focus:outline-none focus:border-indigo-500">
                        <option value="ALL">所有狀態</option>
                        <option value="INCIDENT">⚠️ 異常狀況</option>
                        <option value="ABSENT">👤 有缺考通報</option>
                        <option value="UNCOLLECTED">📝 尚未領卷</option>
                        <option value="TESTING">✍️ 考試進行中</option>
                        <option value="COMPLETED">✅ 已交卷完成</option>
                    </select>
                </div>

                <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
                    <!-- 搜尋框 -->
                    <div class="relative flex-1 sm:w-48">
                        <i data-lucide="search" class="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="searchInput" oninput="renderClassrooms()" placeholder="搜尋班級或監考老師..." class="w-full bg-slate-950 border border-slate-800 text-sm text-white rounded-xl pl-9 pr-3 py-1.5 focus:outline-none focus:border-indigo-500">
                    </div>

                    <!-- 新增考場按鈕 -->
                    <button onclick="openAddRoomModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 shrink-0 shadow-md shadow-indigo-950">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        <span>新增考場</span>
                    </button>
                </div>
            </div>

            <!-- 狀態圖例說明 -->
            <div class="flex flex-wrap items-center gap-4 px-2 text-xs text-slate-400">
                <span class="font-semibold text-slate-300">狀態燈號說明：</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-slate-500"></span>未領卷</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>考試中 (正常)</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>缺考通報</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>突發異常</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>已交卷完成</span>
            </div>

            <!-- 考場卡片網格 -->
            <div id="classroomGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-4">
                <!-- 由 JS 動態渲染考場卡片 -->
            </div>
        </section>

        <!-- 右側：即時異常與缺考通報紀錄 (佔 4 或 3 欄) -->
        <aside class="xl:col-span-4 2xl:col-span-3 flex flex-col gap-4">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl flex flex-col h-full max-h-[calc(100vh-240px)] min-h-[500px] shadow-xl">
                <!-- 面板標題 -->
                <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="relative flex h-3 w-3">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
                        </span>
                        <h2 class="font-bold text-base text-white">即時異常與缺考動態</h2>
                    </div>
                    <button onclick="openQuickLogModal()" class="bg-slate-800 hover:bg-slate-700 text-indigo-300 text-xs font-bold px-2.5 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1">
                        <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> 試務備忘
                    </button>
                </div>

                <!-- 篩選小標籤 -->
                <div class="px-4 py-2 bg-slate-950/50 border-b border-slate-800/80 flex items-center justify-between text-xs">
                    <div class="flex gap-2">
                        <button onclick="setLogFilter('ALL')" id="logFilterAll" class="font-bold text-indigo-400">全部紀錄</button>
                        <span class="text-slate-700">|</span>
                        <button onclick="setLogFilter('UNRESOLVED')" id="logFilterUnresolved" class="text-slate-400 hover:text-white">僅看待處理</button>
                    </div>
                    <span id="logCountBadge" class="text-slate-400 font-mono">0 筆</span>
                </div>

                <!-- 時間軸列表 -->
                <div id="incidentTimeline" class="flex-1 overflow-y-auto p-4 space-y-3">
                    <!-- 由 JS 動態渲染時間軸項目 -->
                </div>
            </div>
        </aside>

    </main>

    <!-- ==================== MODALS (彈出視窗) ==================== -->

    <!-- 1. 考場詳情與回報 Modal -->
    <div id="roomDetailModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4 overflow-y-auto">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-2xl w-full shadow-2xl overflow-hidden my-8">
            <!-- Modal Header -->
            <div class="px-6 py-4 bg-slate-800/80 border-b border-slate-700 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span id="modalRoomBadge" class="text-xl font-black bg-indigo-600 text-white px-3 py-1 rounded-xl">701</span>
                    <div>
                        <h3 class="text-lg font-bold text-white">考場即時回報與管理</h3>
                        <p id="modalRoomSub" class="text-xs text-slate-400">監考老師：王大明</p>
                    </div>
                </div>
                <button onclick="closeModal('roomDetailModal')" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-700 transition">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-6 max-h-[75vh] overflow-y-auto">
                <input type="hidden" id="editRoomId">

                <!-- 基本資訊與試卷狀態 -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-400 mb-1.5">監考老師姓名</label>
                        <input type="text" id="editProctor" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2 text-sm text-white focus:border-indigo-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-400 mb-1.5">試卷收發狀態</label>
                        <select id="editPaperStatus" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2 text-sm text-white font-bold focus:border-indigo-500 focus:outline-none">
                            <option value="UNCOLLECTED">⚪ 尚未領卷</option>
                            <option value="TESTING">🟢 考試進行中</option>
                            <option value="COMPLETED">🔵 已交卷完成</option>
                        </select>
                    </div>
                </div>

                <!-- 人數統計區 -->
                <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-4">
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                        <i data-lucide="users" class="w-4 h-4 text-indigo-400"></i> 考場人數清點
                    </h4>
                    <div class="grid grid-cols-3 gap-3 text-center">
                        <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                            <label class="block text-xs text-slate-400 mb-1">應到人數</label>
                            <input type="number" id="editExpected" min="1" max="60" oninput="recalcModalAttendance()" class="w-full text-center bg-slate-950 border border-slate-700 rounded-lg py-1.5 text-lg font-mono font-bold text-white">
                        </div>
                        <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                            <label class="block text-xs text-emerald-400 mb-1">實到人數</label>
                            <div id="displayActual" class="py-1.5 text-xl font-mono font-black text-emerald-400">30</div>
                        </div>
                        <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                            <label class="block text-xs text-amber-400 mb-1">缺考人數</label>
                            <div id="displayAbsentCount" class="py-1.5 text-xl font-mono font-black text-amber-400">0</div>
                        </div>
                    </div>
                </div>

                <!-- 缺考學生登錄區 -->
                <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
