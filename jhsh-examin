        // ==================== 5. 考場互動與操作邏輯 ====================
        function setGradeFilter(grade) {
            currentGradeFilter = grade;
            document.querySelectorAll('.grade-filter-btn').forEach(btn => {
                if (btn.dataset.grade === grade) {
                    btn.className = 'grade-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 text-white transition';
                } else {
                    btn.className = 'grade-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition';
                }
            });
            renderClassrooms();
        }

        function setStatusFilter(status) {
            currentStatusFilter = status;
            renderClassrooms();
        }

        function setLogFilter(filter) {
            currentLogFilter = filter;
            document.getElementById('logFilterAll').className = filter === 'ALL' ? 'font-bold text-indigo-400' : 'text-slate-400 hover:text-white';
            document.getElementById('logFilterUnresolved').className = filter === 'UNRESOLVED' ? 'font-bold text-indigo-400' : 'text-slate-400 hover:text-white';
            renderTimeline();
        }

        // 一鍵切換試卷狀態：未領卷 -> 考試中 -> 已交卷 -> 考試中
        function cyclePaperStatus(roomId) {
            const room = appState.rooms.find(r => r.id === roomId);
            if (!room) return;

            if (room.paperStatus === 'UNCOLLECTED') {
                room.paperStatus = 'TESTING';
                showToast(`${room.code} 考場已領卷，開始考試`);
            } else if (room.paperStatus === 'TESTING') {
                room.paperStatus = 'COMPLETED';
                showToast(`${room.code} 考場試卷已全數回收完成！`, 'success');
            } else {
                room.paperStatus = 'TESTING';
                showToast(`${room.code} 考場狀態重設為「考試中」`);
            }

            saveState();
            renderAll();
        }

        // 開啟考場詳情與回報 Modal
        function openRoomDetailModal(roomId) {
            const room = appState.rooms.find(r => r.id === roomId);
            if (!room) return;

            document.getElementById('editRoomId').value = room.id;
            document.getElementById('modalRoomBadge').textContent = room.code;
            document.getElementById('modalRoomSub').textContent = `監考老師：${room.proctor}`;
            document.getElementById('editProctor').value = room.proctor;
            document.getElementById('editPaperStatus').value = room.paperStatus;
            document.getElementById('editExpected').value = room.expected;

            // 清空異常輸入欄位
            document.getElementById('newIncidentType').value = '';
            document.getElementById('newIncidentNote').value = '';
            document.getElementById('newAbsentSeat').value = '';
            document.getElementById('newAbsentName').value = '';

            // 複製一份缺考名單供編輯
            tempModalAbsents = JSON.parse(JSON.stringify(room.absents || []));
            renderModalAbsentList();
            recalcModalAttendance();

            openModal('roomDetailModal');
            lucide.createIcons();
        }

        function recalcModalAttendance() {
            const expected = parseInt(document.getElementById('editExpected').value) || 0;
            const absentCount = tempModalAbsents.length;
            const actual = Math.max(0, expected - absentCount);
            document.getElementById('displayActual').textContent = actual;
            document.getElementById('displayAbsentCount').textContent = absentCount;
        }

        function renderModalAbsentList() {
            const listEl = document.getElementById('modalAbsentList');
            if (tempModalAbsents.length === 0) {
                listEl.innerHTML = `<p class="text-xs text-slate-500 py-1">目前無登錄缺考學生</p>`;
                return;
            }

            listEl.innerHTML = tempModalAbsents.map((item, idx) => `
                <div class="flex items-center justify-between bg-slate-900 border border-slate-800 px-3 py-2 rounded-lg text-xs">
                    <div class="flex items-center gap-2.5">
                        <span class="font-mono font-bold text-amber-400 bg-amber-950/80 px-2 py-0.5 rounded">${item.seat} 號</span>
                        <span class="font-bold text-white">${item.name}</span>
                        <span class="text-slate-400 bg-slate-800 px-2 py-0.5 rounded">${item.reason}</span>
                    </div>
                    <button type="button" onclick="removeAbsentFromModal(${idx})" class="text-rose-400 hover:text-rose-300 p-1">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function addAbsentStudentToModal() {
            const seat = document.getElementById('newAbsentSeat').value.trim();
            const name = document.getElementById('newAbsentName').value.trim();
            const reason = document.getElementById('newAbsentReason').value;

            if (!seat || !name) {
                showToast('請輸入缺考學生的座號與姓名', 'error');
                return;
            }

            tempModalAbsents.push({ seat, name, reason });
            document.getElementById('newAbsentSeat').value = '';
            document.getElementById('newAbsentName').value = '';
            
            renderModalAbsentList();
            recalcModalAttendance();
        }

        function removeAbsentFromModal(index) {
            tempModalAbsents.splice(index, 1);
            renderModalAbsentList();
            recalcModalAttendance();
        }

        // 儲存考場詳情
        function saveRoomDetails() {
            const roomId = document.getElementById('editRoomId').value;
            const room = appState.rooms.find(r => r.id === roomId);
            if (!room) return;

            const oldAbsentCount = room.absents ? room.absents.length : 0;
            room.proctor = document.getElementById('editProctor').value.trim() || room.proctor;
            room.paperStatus = document.getElementById('editPaperStatus').value;
            room.expected = parseInt(document.getElementById('editExpected').value) || room.expected;
            room.absents = JSON.parse(JSON.stringify(tempModalAbsents));

            const nowStr = getCurrentTimeHM();

            // 若有新增缺考人數，自動產生時間軸紀錄
            if (room.absents.length > oldAbsentCount) {
                const summary = room.absents.map(a => `${a.seat}號 ${a.name}(${a.reason})`).join('、');
                appState.logs.unshift({
                    id: 'log_' + Date.now(),
                    time: nowStr,
                    room: room.code,
                    type: 'ABSENT',
                    title: `缺考更新 (${room.absents.length}人)`,
                    detail: summary,
                    resolved: true
                });
            }

            // 檢查是否有填寫突發異常狀況
            const incType = document.getElementById('newIncidentType').value;
            const incNote = document.getElementById('newIncidentNote').value.trim();
            if (incType || incNote) {
                room.hasIncident = true;
                appState.logs.unshift({
                    id: 'inc_' + Date.now(),
                    time: nowStr,
                    room: room.code,
                    type: 'INCIDENT',
                    title: incType || '突發狀況通報',
                    detail: incNote || `${room.code} 考場回報異常狀況，請試務人員前往協助。`,
                    resolved: false
                });
                showToast(`已發布 ${room.code} 考場異常通報！`, 'error');
            } else {
                showToast(`${room.code} 考場資料已儲存更新`, 'success');
            }

            saveState();
            closeModal('roomDetailModal');
            renderAll();
        }

        function deleteRoomFromModal() {
            const roomId = document.getElementById('editRoomId').value;
            appState.rooms = appState.rooms.filter(r => r.id !== roomId);
            saveState();
            closeModal('roomDetailModal');
            renderAll();
            showToast('已移除該考場');
        }

        // ==================== 6. 新增考場、廣播、節次編輯、時間軸操作 ====================
        function openAddRoomModal() {
            document.getElementById('addRoomCode').value = '';
            document.getElementById('addRoomProctor').value = '';
            openModal('addRoomModal');
        }

        function confirmAddRoom() {
            const code = document.getElementById('addRoomCode').value.trim();
            const grade = document.getElementById('addRoomGrade').value;
            const expected = parseInt(document.getElementById('addRoomExpected').value) || 30;
            const proctor = document.getElementById('addRoomProctor').value.trim() || '待指派';

            if (!code) {
                showToast('請輸入考場或班級編號', 'error');
                return;
            }

            appState.rooms.push({
                id: 'r_' + Date.now(),
                code,
                grade,
                proctor,
                expected,
                paperStatus: 'UNCOLLECTED',
                hasIncident: false,
                absents: []
            });

            saveState();
            closeModal('addRoomModal');
            renderAll();
            showToast(`已新增 ${code} 考場`, 'success');
        }

        // 試務廣播
        function openBroadcastModal() {
            document.getElementById('broadcastInput').value = appState.broadcast.text;
            const radios = document.getElementsByName('broadcastLevel');
            radios.forEach(r => r.checked = (r.value === appState.broadcast.level));
            openModal('broadcastModal');
        }

        function fillBroadcastTemplate(text, level) {
            document.getElementById('broadcastInput').value = text;
            const radios = document.getElementsByName('broadcastLevel');
            radios.forEach(r => r.checked = (r.value === level));
        }

        function saveBroadcast() {
            const text = document.getElementById('broadcastInput').value.trim();
            if (!text) {
                showToast('廣播內容不能為空', 'error');
                return;
            }
            const level = document.querySelector('input[name="broadcastLevel"]:checked').value;
            appState.broadcast = { text, level };
            saveState();
            closeModal('broadcastModal');
            renderAll();
            showToast('全校試務廣播已更新發布', 'success');
        }

        // 節次切換與編輯
        function changeSession(sessionId) {
            appState.currentSessionId = sessionId;
            if (simulationMode) simSecondsRemaining = 50 * 60; // 重設模擬倒數為 50 分鐘
            saveState();
            updateClockAndTimer();
            const s = appState.sessions.find(item => item.id === sessionId);
            if (s) showToast(`已切換至：${s.name}`);
        }

        function openSessionModal() {
            renderSessionEditorList();
            openModal('sessionModal');
        }

        function renderSessionEditorList() {
            const container = document.getElementById('sessionEditorList');
            container.innerHTML = appState.sessions.map((s, idx) => `
                <div class="grid grid-cols-12 gap-2 items-center bg-slate-950 p-2.5 rounded-xl border border-slate-800 session-edit-row" data-id="${s.id}">
                    <input type="text" value="${s.name}" class="col-span-5 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white font-bold session-name">
                    <input type="time" value="${s.start}" class="col-span-3 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white font-mono session-start">
                    <input type="time" value="${s.end}" class="col-span-3 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white font-mono session-end">
                    <button type="button" onclick="this.closest('.session-edit-row').remove()" class="col-span-1 text-rose-400 hover:text-rose-300 flex justify-center">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function addNewSessionRow() {
            const container = document.getElementById('sessionEditorList');
            const newId = 's_' + Date.now();
            const div = document.createElement('div');
            div.className = 'grid grid-cols-12 gap-2 items-center bg-slate-950 p-2.5 rounded-xl border border-slate-800 session-edit-row';
            div.dataset.id = newId;
            div.innerHTML = `
                <input type="text" value="第六節 自習/補考" class="col-span-5 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white font-bold session-name">
                <input type="time" value="15:30" class="col-span-3 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white font-mono session-start">
                <input type="time" value="16:20" class="col-span-3 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white font-mono session-end">
                <button type="button" onclick="this.closest('.session-edit-row').remove()" class="col-span-1 text-rose-400 hover:text-rose-300 flex justify-center">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
            `;
            container.appendChild(div);
            lucide.createIcons();
        }

        function saveSessionsConfig() {
            const rows = document.querySelectorAll('.session-edit-row');
            const updated = [];
            rows.forEach(row => {
                const name = row.querySelector('.session-name').value.trim();
                const start = row.querySelector('.session-start').value;
                const end = row.querySelector('.session-end').value;
                if (name && start && end) {
                    updated.push({ id: row.dataset.id, name, start, end });
                }
            });

            if (updated.length === 0) {
                showToast('請至少保留一個考試節次', 'error');
                return;
            }

            appState.sessions = updated;
            if (!appState.sessions.some(s => s.id === appState.currentSessionId)) {
                appState.currentSessionId = appState.sessions[0].id;
            }
            saveState();
            closeModal('sessionModal');
            renderAll();
            updateClockAndTimer();
            showToast('考試節次時間表已更新', 'success');
        }

        // 時間軸事件處理
        function toggleLogResolved(logId) {
            const log = appState.logs.find(l => l.id === logId);
            if (!log) return;
            log.resolved = !log.resolved;

            // 若該考場的所有異常都已處理，自動解除考場卡片的紅色異常警示
            if (log.type === 'INCIDENT') {
                const room = appState.rooms.find(r => r.code === log.room);
                if (room) {
                    const stillHasUnresolved = appState.logs.some(l => l.room === room.code && l.type === 'INCIDENT' && !l.resolved);
                    room.hasIncident = stillHasUnresolved;
                }
            }

            saveState();
            renderAll();
        }

        function deleteLog(logId) {
            const target = appState.logs.find(l => l.id === logId);
            appState.logs = appState.logs.filter(l => l.id !== logId);
            if (target && target.type === 'INCIDENT') {
                const room = appState.rooms.find(r => r.code === target.room);
                if (room) {
                    room.hasIncident = appState.logs.some(l => l.room === room.code && l.type === 'INCIDENT' && !l.resolved);
                }
            }
            saveState();
            renderAll();
        }

        function openQuickLogModal() {
            document.getElementById('quickLogText').value = '';
            openModal('quickLogModal');
        }

        function confirmQuickLog() {
            const room = document.getElementById('quickLogRoom').value.trim() || '試務中心';
            const type = document.getElementById('quickLogCategory').value;
            const detail = document.getElementById('quickLogText').value.trim();

            if (!detail) {
                showToast('請輸入紀錄內容', 'error');
                return;
            }

            appState.logs.unshift({
                id: 'ql_' + Date.now(),
                time: getCurrentTimeHM(),
                room,
                type,
                title: type === 'INCIDENT' ? '突發異常通報' : '試務中心備忘',
                detail,
                resolved: type !== 'INCIDENT'
            });

            // 如果填寫的考場存在且為異常，同步標記考場
            if (type === 'INCIDENT') {
                const targetRoom = appState.rooms.find(r => r.code === room);
                if (targetRoom) targetRoom.hasIncident = true;
            }

            saveState();
            closeModal('quickLogModal');
            renderAll();
            showToast('已新增試務紀錄', 'success');
        }

        // ==================== 7. 資料匯出 (CSV) 與重置 ====================
        function exportCSV() {
            const session = appState.sessions.find(s => s.id === appState.currentSessionId) || { name: '段考' };
            const now = new Date();
            const dateStr = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;

            // 加上 BOM (\uFEFF) 確保 Excel 開啟繁體中文不亂碼
            let csvContent = '\uFEFF';
            csvContent += `段考考務即時統計報表 - ${session.name} (${dateStr})\n`;
            csvContent += `考場編號,年級,監考老師,試卷狀態,應到人數,實到人數,缺考人數,缺考學生明細,是否有未處理異常\n`;

            const paperStatusMap = {
                'UNCOLLECTED': '尚未領卷',
                'TESTING': '考試進行中',
                'COMPLETED': '已交卷完成'
            };

            appState.rooms.forEach(r => {
                const absentCount = r.absents ? r.absents.length : 0;
                const actual = Math.max(0, r.expected - absentCount);
                const absentDetail = absentCount > 0 
                    ? r.absents.map(a => `${a.seat}號${a.name}(${a.reason})`).join('；') 
                    : '無';
                const row = [
                    r.code,
                    `${r.grade}年級`,
                    r.proctor,
                    paperStatusMap[r.paperStatus] || r.paperStatus,
                    r.expected,
                    actual,
                    absentCount,
                    `"${absentDetail}"`,
                    r.hasIncident ? '是' : '否'
                ];
                csvContent += row.join(',') + '\n';
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.setAttribute('download', `段考考務報表_${session.name}_${dateStr}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);

            showToast('考務統計報表 (CSV) 已匯出下載！', 'success');
        }

        function openResetConfirmModal() {
            openModal('resetConfirmModal');
        }

        function executeResetData() {
            localStorage.removeItem(STORAGE_KEY);
            appState = {
                sessions: JSON.parse(JSON.stringify(defaultSessions)),
                currentSessionId: 's2',
                rooms: JSON.parse(JSON.stringify(defaultRooms)),
                logs: JSON.parse(JSON.stringify(defaultLogs)),
                broadcast: {
                    text: '請各監考老師於預備鈴響時準時發卷，提醒學生檢查試卷頁數與印刷是否清晰。',
                    level: 'normal'
                }
            };
            saveState();
            closeModal('resetConfirmModal');
            renderAll();
            showToast('已重置為預設模擬資料', 'success');
        }

        // ==================== 8. 通用工具函式 ====================
        function openModal(id) {
            const el = document.getElementById(id);
            el.classList.remove('hidden');
            el.classList.add('flex');
        }

        function closeModal(id) {
            const el = document.getElementById(id);
            el.classList.add('hidden');
            el.classList.remove('flex');
        }

        function getCurrentTimeHM() {
            const now = new Date();
            return `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            let bgClass = 'bg-slate-800 border-slate-700 text-white';
            if (type === 'success') bgClass = 'bg-emerald-900/95 border-emerald-700 text-emerald-100';
            if (type === 'error') bgClass = 'bg-rose-900/95 border-rose-700 text-rose-100';

            toast.className = `${bgClass} border px-4 py-2.5 rounded-xl shadow-2xl text-xs font-bold flex items-center gap-2 transition-all duration-300 translate-y-2 opacity-0`;
            toast.innerHTML = `<span>${message}</span>`;
            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ==================== 9. 啟動系統 ====================
        window.addEventListener('DOMContentLoaded', () => {
            loadState();
            renderAll();
            updateClockAndTimer();
            setInterval(updateClockAndTimer, 1000);
        });
    </script>
</body>
