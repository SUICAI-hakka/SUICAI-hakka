            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            } catch (e) {
                console.error('儲存 LocalStorage 失敗:', e);
            }
        }

        // ==================== 3. 時鐘與考場倒數計時器 ====================
        function updateClockAndTimer() {
            const now = new Date();
            
            // 更新數位時鐘
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('liveClock').textContent = `${hours}:${minutes}:${seconds}`;

            const days = ['週日', '週一', '週二', '週三', '週四', '週五', '週六'];
            const dateStr = `${now.getFullYear()}/${String(now.getMonth() + 1).padStart(2, '0')}/${String(now.getDate()).padStart(2, '0')} (${days[now.getDay()]})`;
            document.getElementById('liveDate').textContent = dateStr;

            // 更新節次倒數計時
            const session = appState.sessions.find(s => s.id === appState.currentSessionId) || appState.sessions[0];
            if (!session) return;

            const statusDot = document.getElementById('timerStatusDot');
            const statusText = document.getElementById('timerStatusText');
            const countdownEl = document.getElementById('countdownDisplay');
            const progressBar = document.getElementById('timerProgressBar');

            if (simulationMode) {
                // 模擬模式：持續倒數，展示試務中心運作效果
                if (simSecondsRemaining > 0) simSecondsRemaining--;
                const m = String(Math.floor(simSecondsRemaining / 60)).padStart(2, '0');
                const s = String(simSecondsRemaining % 60).padStart(2, '0');
                countdownEl.textContent = `${m}:${s}`;
                countdownEl.className = 'text-xl md:text-2xl font-mono font-extrabold text-amber-400 tabular-nums leading-none mt-0.5';
                statusDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping';
                statusText.textContent = '考試進行中 (模擬)';
                statusText.className = 'text-xs font-bold text-emerald-400 tracking-wide';
                const pct = Math.min(100, Math.max(5, (simSecondsRemaining / (50 * 60)) * 100));
                progressBar.style.width = `${pct}%`;
                progressBar.className = 'bg-emerald-500 h-full transition-all duration-500';
            } else {
                // 真實系統時間比對
                const [sh, sm] = session.start.split(':').map(Number);
                const [eh, em] = session.end.split(':').map(Number);

                const startTime = new Date(now); startTime.setHours(sh, sm, 0, 0);
                const endTime = new Date(now); endTime.setHours(eh, em, 0, 0);
                const prepTime = new Date(startTime.getTime() - 5 * 60000); // 考前5分鐘預備鈴

                if (now < prepTime) {
                    // 尚未開始
                    const diffSec = Math.floor((startTime - now) / 1000);
                    const hrs = Math.floor(diffSec / 3600);
                    const mins = Math.floor((diffSec % 3600) / 60);
                    const secs = diffSec % 60;
                    countdownEl.textContent = hrs > 0 
                        ? `${String(hrs).padStart(2,'0')}:${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`
                        : `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
                    countdownEl.className = 'text-xl md:text-2xl font-mono font-extrabold text-slate-300 tabular-nums leading-none mt-0.5';
                    statusDot.className = 'w-2.5 h-2.5 rounded-full bg-slate-500';
                    statusText.textContent = '尚未開始';
                    statusText.className = 'text-xs font-bold text-slate-400 tracking-wide';
                    progressBar.style.width = '0%';
                } else if (now >= prepTime && now < startTime) {
                    // 預備鈴階段
                    const diffSec = Math.floor((startTime - now) / 1000);
                    const mins = String(Math.floor(diffSec / 60)).padStart(2, '0');
                    const secs = String(diffSec % 60).padStart(2, '0');
                    countdownEl.textContent = `${mins}:${secs}`;
                    countdownEl.className = 'text-xl md:text-2xl font-mono font-extrabold text-sky-400 tabular-nums leading-none mt-0.5';
                    statusDot.className = 'w-2.5 h-2.5 rounded-full bg-sky-400 animate-ping';
                    statusText.textContent = '預備鈴 (發卷中)';
                    statusText.className = 'text-xs font-bold text-sky-400 tracking-wide';
                    progressBar.style.width = '100%';
                    progressBar.className = 'bg-sky-400 h-full transition-all duration-500';
                } else if (now >= startTime && now <= endTime) {
                    // 考試進行中
                    const totalSec = (endTime - startTime) / 1000;
                    const diffSec = Math.floor((endTime - now) / 1000);
                    const mins = String(Math.floor(diffSec / 60)).padStart(2, '0');
                    const secs = String(diffSec % 60).padStart(2, '0');
                    countdownEl.textContent = `${mins}:${secs}`;
                    
                    const isLast5Min = diffSec <= 300;
                    countdownEl.className = `text-xl md:text-2xl font-mono font-extrabold ${isLast5Min ? 'text-rose-400 animate-pulse' : 'text-amber-400'} tabular-nums leading-none mt-0.5`;
                    statusDot.className = `w-2.5 h-2.5 rounded-full ${isLast5Min ? 'bg-rose-500' : 'bg-emerald-500'} animate-ping`;
                    statusText.textContent = isLast5Min ? '即將收卷 (最後5分)' : '考試進行中';
                    statusText.className = `text-xs font-bold ${isLast5Min ? 'text-rose-400' : 'text-emerald-400'} tracking-wide`;
                    
                    const pct = Math.max(0, Math.min(100, (diffSec / totalSec) * 100));
                    progressBar.style.width = `${pct}%`;
                    progressBar.className = `${isLast5Min ? 'bg-rose-500' : 'bg-emerald-500'} h-full transition-all duration-500`;
                } else {
                    // 已結束
                    countdownEl.textContent = '00:00';
                    countdownEl.className = 'text-xl md:text-2xl font-mono font-extrabold text-indigo-400 tabular-nums leading-none mt-0.5';
                    statusDot.className = 'w-2.5 h-2.5 rounded-full bg-indigo-500';
                    statusText.textContent = '本節考試已結束';
                    statusText.className = 'text-xs font-bold text-indigo-400 tracking-wide';
                    progressBar.style.width = '0%';
                }
            }
        }

        function toggleSimulationMode() {
            simulationMode = !simulationMode;
            const btn = document.getElementById('simBtn');
            if (simulationMode) {
                simSecondsRemaining = 38 * 60 + 42;
                btn.textContent = '模擬中';
                btn.classList.add('text-amber-300', 'border-amber-700');
                showToast('已切換為「模擬考試倒數」模式');
            } else {
                btn.textContent = '即時鐘';
                btn.classList.remove('text-amber-300', 'border-amber-700');
                showToast('已切換為「真實系統時間」比對模式');
            }
            updateClockAndTimer();
        }

        // ==================== 4. 渲染畫面邏輯 ====================
        function renderAll() {
            renderBroadcast();
            renderSessionSelector();
            renderKPIs();
            renderClassrooms();
            renderTimeline();
            lucide.createIcons();
        }

        // 渲染頂部廣播橫幅
        function renderBroadcast() {
            const banner = document.getElementById('broadcastBanner');
            const badge = document.getElementById('broadcastBadge');
            const textEl = document.getElementById('broadcastText');

            textEl.textContent = appState.broadcast.text;
            if (appState.broadcast.level === 'urgent') {
                banner.className = 'bg-rose-600 text-white px-4 py-2.5 shadow-lg shadow-rose-950/50 transition-colors duration-300 flex items-center justify-between gap-3 z-30';
